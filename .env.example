# Front (Vite) — URL du serveur boardgame.io.
# DEV : laisser vide → http://<hostname>:8000
# Prod (nginx même domaine) : laisser vide → window.location.origin
# Prod (API séparée) : https://jeu.example.fr   ou   http://IP:8000
# VITE_GAME_SERVER_URL=

# Serveur Node (server.ts) — pas préfixés VITE_
# PORT=8000
# MAX_ACTIVE_MATCHES=20
# Origines CORS supplémentaires (virgules) : front prod / IP
# CORS_ORIGINS=https://jeu.example.fr,http://77.x.x.x
