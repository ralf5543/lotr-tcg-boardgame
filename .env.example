# Serveur Node (boardgame.io + comptes)
PORT=8000
MAX_ACTIVE_MATCHES=20
# Origines front supplémentaires (prod), séparées par des virgules
# CORS_ORIGINS=https://lotr-tcg-online.raphael-bigot.info

# SQLite comptes (défaut : data/lotr.sqlite)
# LOTR_DB_PATH=/var/www/lotr-tcg/data/lotr.sqlite

# Cookies session : 1 = Secure (HTTPS), 0 = HTTP local, sinon auto via X-Forwarded-Proto
# COOKIE_SECURE=1
